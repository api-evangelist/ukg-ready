{
  "opencollection": "1.0.0",
  "info": {
    "name": "UKG Ready Authentication Content API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Content",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a post",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{hostname}/api/content/v1/posts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new content post in the tenant."
        }
      ]
    }
  ],
  "bundled": true
}
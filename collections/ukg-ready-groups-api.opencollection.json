            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a paginated collection of workgroups for the tenant."
        }
      ]
    }
  ],
  "bundled": true
}
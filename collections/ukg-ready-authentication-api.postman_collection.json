      "name": "Authentication",
      "description": {
        "content": "Access token issuance",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "18bd73e5-51e8-4848-bd5c-d818ad390916",
          "name": "Request an OAuth 2.0 access token",
          "request": {
            "name": "Request an OAuth 2.0 access token",
            "description": {
              "content": "Exchange credentials (username, password, client_id, client_secret)\nfor an OAuth 2.0 bearer access token used by all other endpoints.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authentication",
                "access_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Customer-specific UKG Ready hostname assigned at provisioning",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<string>\",\n  \"password\": \"<password>\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<password>\",\n  \"grant_type\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "8719ea8f-4aa1-46fc-aaea-435b09540a7c",
              "name": "Access token issued",
              "originalRequest": {
                "url": {
                  "path": [
                    "authentication",
                    "access_token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Customer-specific UKG Ready hostname assigned at provisioning",
                      "type": "any",
                      "value": "{{hostname}}",
                      "key": "hostname"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"<string>\",\n  \"password\": \"<password>\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<password>\",\n  \"grant_type\": \"password\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }

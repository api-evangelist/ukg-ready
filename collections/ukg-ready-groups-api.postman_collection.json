    "_postman_id": "e1002dd3-12ae-430d-8f34-e8d5b5281cff",
    "name": "UKG Ready Authentication Groups API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "UKG Ready is UKG's unified Human Capital Management suite for small and\nmidmarket organizations. The REST API is tenant-hosted: each customer\nhas a unique hostname (https://{hostname}/api). Authentication uses\nOAuth 2.0; clients exchange credentials at the access_token endpoint\nand present the resulting bearer token on subsequent calls.\n\nThis specification documents the public endpoints surfaced in the UKG\nReady quick-start documentation. Full tenant-specific schemas require\naccess to the UKG developer portal.\n\n\nContact Support:\n Name: UKG Developer Portal",
      "type": "text/plain"
    }
  }
